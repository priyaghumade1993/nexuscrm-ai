# ============================================================
# NexusCRM AI — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
APP_NAME="NexusCRM AI"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexuscrm
POSTGRES_USER=nexuscrm_user
POSTGRES_PASSWORD=nexuscrm_password
DATABASE_URL=postgresql+asyncpg://nexuscrm_user:nexuscrm_password@localhost:5432/nexuscrm
DATABASE_URL_SYNC=postgresql://nexuscrm_user:nexuscrm_password@localhost:5432/nexuscrm

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nexuscrm_ai

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# --- Vector Store ---
# Options: faiss | chroma | pinecone
VECTOR_STORE=faiss

# FAISS
FAISS_INDEX_PATH=./data/faiss_index

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=nexuscrm_knowledge

# Pinecone (production)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=nexuscrm-knowledge

# --- Embeddings ---
# Options: openai | huggingface
EMBEDDING_PROVIDER=openai
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=nexuscrm-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- AWS (for production deployment) ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nexuscrm-documents

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_TENANT_PER_MINUTE=200

# --- Knowledge Base ---
KNOWLEDGE_BASE_DIR=./knowledge_base
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# --- Agent ---
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true
